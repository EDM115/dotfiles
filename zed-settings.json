{
  "agent": {
    "default_model": {
      "effort": "low",
      "enable_thinking": true,
      "model": "gpt-5.6-sol",
      "provider": "openai-subscribed"
    },
    "default_profile": "write",
    "dock": "right",
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "favorite_models": [],
    "message_editor_min_lines": 3,
    "model_parameters": [],
    "profiles": {
      "write": {
        "context_servers": {
          "github": {
            "tools": {
              "add_comment_to_pending_review": false,
              "add_issue_comment": false,
              "add_reply_to_pull_request_comment": false,
              "assign_copilot_to_issue": false,
              "create_branch": false,
              "create_or_update_file": false,
              "create_pull_request": false,
              "create_pull_request_with_copilot": false,
              "create_repository": false,
              "delete_file": false,
              "fork_repository": false,
              "get_copilot_job_status": false,
              "get_tag": true,
              "get_team_members": false,
              "get_teams": false,
              "issue_write": false,
              "list_issue_fields": false,
              "list_issue_types": false,
              "list_repository_collaborators": false,
              "list_tags": false,
              "merge_pull_request": false,
              "pull_request_review_write": false,
              "push_files": false,
              "request_copilot_review": false,
              "run_secret_scanning": false,
              "sub_issue_write": false,
              "update_pull_request": false,
              "update_pull_request_branch": false
            }
          },
          "mcp-server-context7": {
            "tools": {
              "query-docs": false,
              "resolve-library-id": false
            }
          }
        },
        "enable_all_context_servers": true,
        "name": "Write",
        "tools": {
          "apply_code_action": true,
          "copy_path": true,
          "create_directory": true,
          "create_thread": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "grep": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "move_path": true,
          "read_file": true,
          "rename_symbol": true,
          "search_web": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true,
          "write_file": true
        }
      }
    },
    "sandbox_permissions": {
      "allow_all_hosts": true
    },
    "show_turn_stats": true,
    "sidebar_side": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^sed\\b"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^wc\\b"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^tail\\b"
            },
            {
              "pattern": "^uv run ruff\\b"
            },
            {
              "pattern": "^uv run ty\\b"
            },
            {
              "pattern": "^uv run pytest\\b"
            },
            {
              "pattern": "^echo\\s+===(\\s|$)"
            }
          ]
        }
      }
    },
    "use_modifier_to_send": true
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "cline": {
      "default_config_options": {
        "auto_approve": true,
        "model": "cline-pass/deepseek-v4-flash",
        "provider": "cline-pass"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "high"
      },
      "favorite_config_option_values": {
        "model": [
          "gpt-5.5"
        ]
      },
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    }
  },
  "auto_indent_on_paste": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "Fira Code",
  "buffer_font_size": 14.0,
  "cli_default_open_behavior": "existing_window",
  "context_servers": {
    "github": {
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "mcp-server-context7": {
      "enabled": true,
      "remote": false
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "diff_view_style": "split",
  "edit_predictions": {
    "allow_data_collection": "yes"
  },
  "ensure_final_newline_on_save": true,
  "file_types": {
    "css": [
      "*.css"
    ],
    "html": [
      "*.html"
    ],
    "jsonc": [
      "*.json5"
    ],
    "python": [
      "*.py"
    ]
  },
  "format_on_save": "off",
  "git": {
    "file_diff": {
      "show_full_file": false
    },
    "inline_blame": {
      "enabled": true,
      "location": "status_bar"
    }
  },
  "git_panel": {
    "collapse_untracked_diff": true,
    "dock": "left",
    "entry_primary_click_action": "file_diff",
    "fallback_branch_name": "master",
    "file_icons": true,
    "group_by": "staging",
    "show_count_badge": true,
    "tree_view": true
  },
  "hide_mouse": "never",
  "icon_theme": "VSCode Icons for Zed (Dark)",
  "inlay_hints": {
    "enabled": true,
    "show_background": false
  },
  "languages": {
    "C++": {
      "remove_trailing_whitespace_on_save": false,
      "tab_size": 4
    },
    "Git Commit": {
      "preferred_line_length": 500,
      "wrap_guides": [
        50,
        72
      ]
    },
    "Python": {
      "language_servers": [
        "!basedpyright",
        "ty"
      ],
      "tab_size": 4
    },
    "TypeScript": {
      "inlay_hints": {
        "enabled": false
      },
      "language_servers": [
        "typescript-ls",
        "vtsls",
        "!typescript-language-server"
      ]
    }
  },
  "line_ending": "prefer_lf",
  "linked_edits": true,
  "lsp": {
    "clangd": {
      "initialization_options": {
        "fallbackFlags": [
          "--target=x86_64-pc-windows-msvc",
          "-std=c++20",
          "-DWINVER=0x0A00",
          "-D_WIN32_WINNT=0x0A00",
          "-DUNICODE",
          "-D_UNICODE",
          "-Iinclude",
          "-Isrc",
          "-ID:/EDM115/Programmes/Windhawk/Compiler/include"
        ]
      }
    },
    "discord_presence": {
      "initialization_options": {
        "application_id": "1263505205522337886",
        "base_icons_url": "https://raw.githubusercontent.com/xhyrom/zed-discord-presence/main/assets/icons/",
        "details": "In {workspace}",
        "git_integration": true,
        "idle": {
          "action": "change_activity",
          "details": "In Zed",
          "large_image": "{base_icons_url}/zed.png",
          "large_text": "Zed",
          "small_image": "{base_icons_url}/idle.png",
          "small_text": "Idle",
          "state": "Idling",
          "timeout": 300
        },
        "large_image": "{base_icons_url}/{language:lo}.png",
        "large_text": "{language:u}",
        "small_image": "{base_icons_url}/zed.png",
        "small_text": "Zed",
        "state": "Working on {filename}"
      }
    }
  },
  "minimap": {
    "show": "always",
    "thumb": "always"
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "outline_panel": {
    "dock": "left"
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "diagnostic_badges": true,
    "dock": "left",
    "git_status_indicator": true,
    "hide_root": true,
    "scrollbar": {
      "horizontal_scroll": true
    },
    "starts_open": true
  },
  "redact_private_values": false,
  "remove_trailing_whitespace_on_save": false,
  "reveal_if_open": true,
  "session": {
    "trust_all_worktrees": true
  },
  "show_edit_predictions": true,
  "soft_wrap": "editor_width",
  "status_bar": {
    "line_endings_button": true,
    "show_active_file": false
  },
  "tab_size": 2,
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "terminal": {
    "blinking": "on",
    "copy_on_select": true,
    "cursor_shape": "underline",
    "env": {},
    "flexible": true,
    "font_family": "FiraCode Nerd Font Propo",
    "max_scroll_history_lines": 1000000,
    "shell": "system",
    "show_count_badge": true
  },
  "theme": "Dracula Pro (Van Helsing)",
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": true
  },
  "ui_font_size": 16.0,
  "use_on_type_format": false
}
